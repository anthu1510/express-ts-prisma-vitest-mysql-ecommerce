{
  "name": "ecommerce-api",
  "version": "1.0.0",
  "description": "E-commerce REST API with Express, TypeScript, Prisma, and JWT Auth",
  "main": "dist/app.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/app.js",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc && dts-bundle-generator -o dist/index.d.ts src/app.ts",
    "build:types": "dts-bundle-generator -o dist/index.d.ts src/app.ts",
    "start": "node dist/app.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "jwt",
    "ecommerce"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.16",
    "dts-bundle-generator": "^9.5.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  }
}
